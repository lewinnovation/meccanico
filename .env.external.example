# Traefik Configuration
# Set these to your actual domains
API_DOMAIN=api.meccanico.com
WEB_DOMAIN=meccanico.com
API_URL=https://api.meccanico.com

# Security
# IMPORTANT: Generate a strong secret for production!
# Use: openssl rand -base64 32
JWT_SECRET=your-production-secret-key-change-this
CORS_ORIGIN=https://meccanico.com

# Database Configuration (optional, defaults are fine for most cases)
POSTGRES_USER=meccanico
POSTGRES_PASSWORD=your-secure-db-password
POSTGRES_DB=meccanico

# Backend Configuration
NODE_ENV=production
PORT=4000
DB_HOST=postgres
DB_PORT=5432
DB_NAME=meccanico
DB_USER=meccanico
DB_PASSWORD=your-secure-db-password

# Database SSL Configuration (required for cloud databases)
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
