{
  "name": "@meccanico/backend",
  "version": "0.1.0",
  "description": "Meccanico API Server - Vehicle repair shop management backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsoa spec-and-routes && tsc",
    "start": "node dist/server.js",
    "tsoa:generate": "tsoa spec-and-routes",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/config/database.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/config/database.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/config/database.ts",
    "db:reset": "ts-node src/utils/resetDatabase.ts",
    "db:seed": "ts-node src/utils/seedData.ts",
    "db:seed:prod": "node dist/utils/seedData.js",
    "db:setup": "ts-node src/utils/resetAndSeed.ts",
    "db:migrate-templates": "ts-node src/utils/migrateCommunicationTemplates.ts",
    "db:add-versions": "ts-node src/utils/addVersionColumns.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "RUN_INTEGRATION_TESTS=true jest --testPathPattern=integration",
    "test:email": "RUN_INTEGRATION_TESTS=true jest --testPathPattern=email.test",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@types/nodemailer": "^7.0.4",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.11",
    "pg": "^8.11.3",
    "puppeteer": "^24.34.0",
    "reflect-metadata": "^0.1.14",
    "swagger-ui-express": "^5.0.0",
    "tsoa": "^6.0.0",
    "typeorm": "^0.3.19",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@jest/test-sequencer": "^30.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
