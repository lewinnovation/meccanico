# Node.js Environment
# Options: development, production
NODE_ENV=development

# Server Configuration
PORT=4000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meccanico
DB_USER=meccanico
DB_PASSWORD=meccanico_dev_password

# JWT Configuration
# IMPORTANT: Change this in production!
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
# For local development: http://localhost:3000
# For production: https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# Logging
# Options: debug, info, warn, error
LOG_LEVEL=info

# SSL Configuration (optional)
# Set to 'true' to enable SSL, 'false' to disable, or 'require' for require mode
# For cloud databases (e.g., GCP Cloud SQL), set to 'true'
DB_SSL=false
# Set to 'true' to reject unauthorized certificates (default: false, needed for cloud DBs)
DB_SSL_REJECT_UNAUTHORIZED=false
